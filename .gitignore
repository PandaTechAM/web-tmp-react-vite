# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
dist-ssr/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Lockfiles from other package managers
yarn.lock
pnpm-lock.yaml
bun.lockb

# Environment files
# All env files are ignored EXCEPT .env.local which we keep tracked as the
# project's local-dev template. Real secrets must never go in .env.local.
.env
.env.*
!.env.local
*.local
!.env.local

# TypeScript build info
*.tsbuildinfo

# Vite cache
.vite/

# Editor - VSCode (preserve recommended extensions + shared settings)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.history/

# Editor - JetBrains
.idea/

# Editor - Visual Studio
.vs/

# Editor - vim
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

